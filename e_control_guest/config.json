{
  "name": "e-Control Guest",
  "version": "0.1.0-rc36",
  "slug": "e_control_guest",
  "description": "Condivisione controllata e verificabile di dashboard Guest",
  "url": "https://github.com/edmondoalex/e-Control_Guest",
  "arch": [
    "amd64",
    "aarch64",
    "armv7",
    "armhf",
    "i386"
  ],
  "startup": "application",
  "boot": "manual",
  "init": false,
  "ingress": true,
  "ingress_port": 8099,
  "panel_icon": "mdi:account-key",
  "homeassistant_api": true,
  "hassio_api": true,
  "ports": {
    "8100/tcp": null
  },
  "ports_description": {
    "8100/tcp": "Portale Guest: pubblicare soltanto dietro HTTPS"
  },
  "options": {
    "guest_port": 8100,
    "guest_base_url": "",
    "allow_insecure_local_http": false,
    "session_minutes": 30,
    "session_idle_minutes": 3,
    "polling_seconds": 60,
    "audit_retention_days": 365,
    "audit_max_events": 100000,
    "trusted_proxy_cidrs": [],
    "cloudflare_proxy_cidrs": [],
    "cloudflare_proxy_secret": ""
  },
  "schema": {
    "guest_port": "port",
    "guest_base_url": "str?",
    "allow_insecure_local_http": "bool",
    "session_minutes": "int(5,240)",
    "session_idle_minutes": "int(1,60)",
    "polling_seconds": "int(15,3600)",
    "audit_retention_days": "int(30,3650)",
    "audit_max_events": "int(1000,1000000)",
    "trusted_proxy_cidrs": [
      "str"
    ],
    "cloudflare_proxy_cidrs": [
      "str"
    ],
    "cloudflare_proxy_secret": "password?"
  },
  "image": "ghcr.io/edmondoalex/ekonex-econtrol-guest"
}
